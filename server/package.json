{
  "name": "rolly-api",
  "version": "1.0.0",
  "private": true,
  "description": "API de Maus: webhook de WhatsApp Cloud API, procesamiento de PDF en servidor y PostgreSQL.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "tsc -p tsconfig.json && cp src/db/schema.sql dist/db/schema.sql",
    "start": "node dist/server.js",
    "migrate": "node dist/db/migrate.js",
    "migrate:dev": "tsx --env-file-if-exists=../.env src/db/migrate.ts",
    "create-admin": "node dist/scripts/create-admin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "docx": "9.5.1",
    "express": "5.1.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "pg": "8.16.3",
    "pino": "9.14.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.12",
    "@types/pg": "8.15.5",
    "pino-pretty": "13.1.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
