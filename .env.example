# ================================================================
#  Maus / DocuMaus — variables de entorno
#  Copia este archivo:  cp .env.example .env   y completa los valores.
#  .env NUNCA se sube a GitHub (está en .gitignore).
# ================================================================

# ---------- Servidor ----------
PORT=3000
# Tu dominio, sin https:// ni barra final (para HTTPS, canónicas y enlaces)
DOMAIN=documaus.com
# Correo para avisos de Let's Encrypt (vencimiento del certificado)
LETSENCRYPT_EMAIL=tucorreo@gmail.com

# ---------- Base de datos (PostgreSQL 16) ----------
POSTGRES_DB=rolly
POSTGRES_USER=rolly
# Genera una con:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
POSTGRES_PASSWORD=cambia-esta-clave
# Dentro de docker compose se arma sola. Para correr la API fuera de Docker:
DATABASE_URL=postgres://rolly:cambia-esta-clave@localhost:5432/rolly

# ---------- WhatsApp Cloud API (developers.facebook.com → tu app → WhatsApp) ----------
# Frase secreta que tú inventas; la misma va en Meta → WhatsApp → Configuración → Webhook → "Token de verificación"
META_VERIFY_TOKEN=inventa-una-frase-larga-y-secreta
# Token de acceso PERMANENTE de un "usuario del sistema" (Business Settings → Usuarios del sistema)
META_ACCESS_TOKEN=EAAG...
# Identificador del número de teléfono (WhatsApp → Configuración de la API)
PHONE_NUMBER_ID=123456789012345
# "Clave secreta de la app" (Configuración de la app → Básica). Sin ella no se puede verificar
# que los mensajes vienen de Meta (firma X-Hub-Signature-256). ¡Obligatoria!
META_APP_SECRET=0123456789abcdef0123456789abcdef
GRAPH_API_VERSION=v21.0

# ---------- Negocio ----------
BRAND_NAME=DocuMaus
# Documentos gratis por mes en WhatsApp por número, y del plan Pro WhatsApp
FREE_MONTHLY_QUOTA=10
PRO_MONTHLY_QUOTA=500
PRO_PRICE_TEXT=S/ 9 al mes
# Tu WhatsApp personal para ventas y soporte (código de país + número, sin +). Opcional.
SUPPORT_WHATSAPP=
# Token para la API de administración (activar Pro, estadísticas). Genera con:  openssl rand -hex 32
ADMIN_API_TOKEN=cambia-esto-por-un-token-de-64-caracteres-hex

# ---------- Procesamiento ----------
MAX_FILE_MB=100
SESSION_TTL_MINUTES=30
WORKER_CONCURRENCY=2
JOB_TIMEOUT_SECONDS=180
LOG_LEVEL=info
API_MEM_LIMIT=1g
